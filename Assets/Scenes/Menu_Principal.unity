  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e2339b5803ce334c926f8eda95e076a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  menuPersonagens: {fileID: 0}
  subMenuPersonagens: {fileID: 0}
  pnl_Capa_Est: {fileID: 1582636947}
  pnl_MenuMapa_Est: {fileID: 345789220}
  pnl_Grade_Est: {fileID: 1082708491}
  img_MenuMapa_Est: {fileID: 1706606706}
  txt_Titulo_Est: {fileID: 1687135462}
  txt_Desc_Est: {fileID: 2885855}
  pnl_Capa_Exp: {fileID: 142455187}
  pnl_MenuMapa_Exp: {fileID: 483575626}
  pnl_Grade_Exp: {fileID: 1309408932}
  img_MenuMapa_Exp: {fileID: 3582536908055494966}
  txt_Titulo_Exp: {fileID: 1285001363}
  txt_Desc_Exp: {fileID: 1065313007}
  dropdownModo: {fileID: 1213038193}
  mapaSelecionado: Floresta
  mapasEstaticos:
  - titulo: "Casa Su\xED\xE7a"
    nomeDaCena: "Casa_Su\xED\xE7a"
    descricao: "Sinta o aconchego de um dia calmo no campo. Neste cen\xE1rio, voc\xEA
      estar\xE1 no quintal de uma linda casa t\xEDpica da Su\xED\xE7a, cercado por
      flores, muito verde e montanhas ao fundo. Um lugar acolhedor e familiar, ideal
      para se exercitar com calma, curtindo a paz da natureza."
    imagem: {fileID: 2800000, guid: 9c12371de8b2c1e4486e41e949fa747d, type: 3}
  - titulo: Montanhas Nevadas
    nomeDaCena: Montanhas_Nevadas
    descricao: "Imagine-se no topo do mundo! Aqui voc\xEA acompanha a vista deslumbrante
      de uma ponte segura bem no meio das montanhas cobertas de neve da Su\xED\xE7a.
      \xC9 o cen\xE1rio perfeito para respirar fundo, relaxar a mente e focar totalmente
      no seu equil\xEDbrio e na postura com toda a tranquilidade."
    imagem: {fileID: 2800000, guid: 99ee9c82f2b0eb241830ac6976d03177, type: 3}
  mapasExploraveis:
  - titulo: Floresta e Rio
    nomeDaCena: Floresta_e_Rio
    descricao: "Terreno com obst\xE1culos naturais. O rio cria resist\xEAncia constante
      nas juntas do joelho, ideal para ganho de for\xE7a. A areia movedi\xE7a e ra\xEDzes
      alteram as perturba\xE7\xF5es no quadril, treinando propriocep\xE7\xE3o e equil\xEDbrio."
    imagem: {fileID: 2800000, guid: fb392392c261678469f2bd531b78b062, type: 3}
  - titulo: Centro Metropolitano
    nomeDaCena: Centro_Metropolitano
    descricao: "Cen\xE1rio urbano simulando o dia a dia. Cal\xE7adas irregulares
      e rampas exigem adapta\xE7\xE3o da marcha. O exoesqueleto recria o impacto
      do asfalto e guias, treinando a coordena\xE7\xE3o motora para devolver a autonomia
      do paciente."
    imagem: {fileID: 2800000, guid: 157633bc9d34d2d40a95b8861df83c7d, type: 3}
  - titulo: Templo Zen
    nomeDaCena: Templo Zen
    descricao: "Ambiente com baixo est\xEDmulo sensorial. O piso liso de madeira
      cria uma resist\xEAncia mec\xE2nica leve e previs\xEDvel. Ideal para fases
      iniciais, direcionando o foco absoluto do paciente para a consci\xEAncia corporal
      e fluidez do movimento."
    imagem: {fileID: 2800000, guid: 157633bc9d34d2d40a95b8861df83c7d, type: 3}
  - titulo: "Esta\xE7\xE3o Gravidade Zero"
    nomeDaCena: "Esta\xE7\xE3o Gravidade Zero"
    descricao: "Cen\xE1rio espacial com gravidade alterada. Pisos magn\xE9ticos exigem
      for\xE7a extra no quadril para erguer o p\xE9, focando em pot\xEAncia. Zonas
      de baixa gravidade demandam controle suave na descida, treinando a precis\xE3o
      motora e a manuten\xE7\xE3o do equil\xEDbrio."
    imagem: {fileID: 2800000, guid: 157633bc9d34d2d40a95b8861df83c7d, type: 3}
  - titulo: Trilha Alpina
    nomeDaCena: Trilha Alpina
    descricao: "Terreno agressivo com neve espessa. O arraste cont\xEDnuo cria resist\xEAncia
      viscosa nos motores, ideal para for\xE7a. Pedras falsas geram solavancos e
      perturba\xE7\xF5es assim\xE9tricas em apenas uma das pernas, treinando a reatividade
      r\xE1pida e o equil\xEDbrio."
    imagem: {fileID: 2800000, guid: 157633bc9d34d2d40a95b8861df83c7d, type: 3}
